---
import Base from '../layouts/Base.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
---

<Base
  title="叙事工具箱 | 八刀评估表·叙事人格测试·15+模板 - 雕龙"
  description="雕龙叙事工具箱：八刀评估表（八维度评估叙事质量）、叙事人格测试（发现你的叙事风格）、15+场景模板。让叙事能力可衡量、可练习。"
  locale="zh"
>
  <div class="page-header">
    <h1>工具箱</h1>
    <p>让叙事能力可衡量、可练习</p>
  </div>

  <div class="page-content">
    <div class="card-grid">

      <div class="card">
        <span class="card-tag">测试</span>
        <h3>叙事人格测试</h3>
        <p>8道题，发现你的叙事风格类型：INTJ战略型 / ENFJ激励型 / ENFP创意型 / INFJ隐喻型</p>
        <a href="/tools/narrative-personality-test.html" target="_blank">开始测试 →</a>
      </div>

      <div class="card">
        <span class="card-tag">评估</span>
        <h3>八刀评估表</h3>
        <p>从历史、辩证、现象、语言、形式、存在、美感、元反思八个维度评估叙事质量。每刀附评分标准。</p>
        <a href="https://github.com/lj22503/diaolong-skill/blob/main/tools/八刀评估提示词.md" target="_blank">查看 →</a>
      </div>

      <div class="card">
        <span class="card-tag">模板</span>
        <h3>15+ 场景模板</h3>
        <p>个人IP、品牌故事、产品发布、融资Pitch、销售脚本、危机公关、社交媒体……可直接使用或改造。</p>
        <a href="https://github.com/lj22503/diaolong-skill/tree/main/templates" target="_blank">GitHub 查看 →</a>
      </div>

      <div class="card">
        <span class="card-tag">社群</span>
        <h3>雕龙叙事实验室</h3>
        <p>正在和朋友们讨论有趣的话题，一起来吧？知识星球付费社群，19-49元/年。</p>
        <a href="https://t.zsxq.com/CLU1d" target="_blank">加入星球 →</a>
      </div>

    </div>
  </div>
  <RelatedLinks
    title="继续探索"
    links={[
      { href: '/book', tag: '书籍', title: '《叙事引擎》', desc: '22章完整方法论，理解工具背后的原理' },
      { href: '/skills', tag: 'Skill', title: '26个场景Skill', desc: '覆盖个人、商业、公益等5大类共26个场景' },
      { href: '/examples', tag: '案例', title: '案例库', desc: '工具在真实项目中的使用案例' },
    ]}
  />

</Base>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .card {
    background: var(--bg-secondary);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .card:hover {
    border-color: var(--accent);
    box-shadow: 0 2px 12px rgba(192,57,43,0.06);
  }

  .card-tag {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .card h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 8px 0 6px;
  }

  .card p {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 12px;
  }

  .card a {
    font-size: 0.82rem;
    color: var(--accent);
    font-weight: 500;
  }

  @media (max-width: 600px) {
    .card-grid { grid-template-columns: 1fr; }
  }
</style>

---
interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: 'website' | 'article';
  locale?: 'zh' | 'en';
  jsonLd?: string;
}

const {
  title,
  description,
  ogImage = '/images/book-cover.jpg',
  type = 'website',
  locale = 'zh',
  jsonLd,
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://diaolong.mangofolio.com';
const canonicalURL = `${siteUrl}${currentPath === '/' ? '/' : currentPath}`;
const ogImageURL = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// 面包屑：用于内页（P1-10）
const isHomePage = currentPath === '/' || currentPath === '/en/' || currentPath === '/en';
const showBreadcrumb = !isHomePage;
const pathSegments = currentPath.split('/').filter(Boolean);
// 去掉可能的 'en' 前缀
const breadcrumbItems: { name: string; href: string }[] = [{ name: locale === 'en' ? 'Home' : '首页', href: locale === 'en' ? '/en/' : '/' }];
const sectionNames: Record<string, { zh: string; en: string }> = {
  book: { zh: '书籍', en: 'Book' },
  skills: { zh: 'Skill 工具箱', en: 'Skills' },
  tools: { zh: '叙事工具箱', en: 'Tools' },
  examples: { zh: '案例库', en: 'Examples' },
  community: { zh: '社区', en: 'Community' },
  about: { zh: '关于', en: 'About' },
};
if (pathSegments.length > 0) {
  const section = pathSegments[pathSegments[0] === 'en' ? 1 : 0];
  if (section && sectionNames[section]) {
    const sectionHref = locale === 'en' ? `/en/${section}` : `/${section}`;
    breadcrumbItems.push({ name: sectionNames[section][locale], href: sectionHref });
  }
}
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: `${siteUrl}${item.href}`,
  })),
};
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
  <meta property="og:site_name" content="雕龙 DragonCraft" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <!-- hreflang -->
  <link rel="alternate" hreflang="zh" href={currentPath.startsWith('/en') ? currentPath.replace('/en', '') || '/' : currentPath} />
  <link rel="alternate" hreflang="en" href={currentPath.startsWith('/en') ? currentPath : `/en${currentPath}`} />
  <link rel="alternate" hreflang="x-default" href={currentPath.startsWith('/en') ? currentPath.replace('/en', '') || '/' : currentPath} />

  <!-- 面包屑 JSON-LD（二级页及以上） -->
  {showBreadcrumb && (
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  )}

  <!-- 页面自定义 JSON-LD -->
  {jsonLd && <Fragment set:html={jsonLd} />}
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href={locale === 'en' ? '/en/' : '/'} class="logo">
        <span class="logo-zh">雕龙</span>
        <span class="logo-en">DragonCraft</span>
      </a>
      <nav class="main-nav">
        <a href={locale === 'en' ? '/en/book' : '/book'} class:list={[{ active: currentPath.startsWith('/book') }]}>书籍</a>
        <a href={locale === 'en' ? '/en/skills' : '/skills'} class:list={[{ active: currentPath.startsWith('/skills') }]}>Skill</a>
        <a href={locale === 'en' ? '/en/tools' : '/tools'} class:list={[{ active: currentPath.startsWith('/tools') }]}>工具</a>
        <a href={locale === 'en' ? '/en/examples' : '/examples'} class:list={[{ active: currentPath.startsWith('/examples') }]}>案例</a>
        <a href={locale === 'en' ? '/en/community' : '/community'} class:list={[{ active: currentPath.startsWith('/community') }]}>社区</a>
        <a href={locale === 'en' ? '/en/about' : '/about'} class:list={[{ active: currentPath.startsWith('/about') }]}>关于</a>
      </nav>
      <div class="header-right">
        <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="打开菜单">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
        <div class="lang-switch">
          <a href={locale === 'en' ? (currentPath.startsWith('/en') ? currentPath : `/en${currentPath}`) : currentPath.replace('/en', '') || '/'}>
            {locale === 'zh' ? 'EN' : '中'}
          </a>
        </div>
      </div>
    </div>
    <div class="mobile-nav" id="mobileNav">
      <a href={locale === 'en' ? '/en/book' : '/book'}>书籍</a>
      <a href={locale === 'en' ? '/en/skills' : '/skills'}>Skill</a>
      <a href={locale === 'en' ? '/en/tools' : '/tools'}>工具</a>
      <a href={locale === 'en' ? '/en/examples' : '/examples'}>案例</a>
      <a href={locale === 'en' ? '/en/community' : '/community'}>社区</a>
      <a href={locale === 'en' ? '/en/about' : '/about'}>关于</a>
    </div>
  </header>

  <!-- 面包屑导航视觉 -->
  {showBreadcrumb && (
    <nav class="breadcrumb" aria-label="面包屑导航">
      <div class="breadcrumb-inner">
        {breadcrumbItems.map((item, i) => (
          <span class="breadcrumb-item">
            <a href={item.href}>{item.name}</a>
            {i < breadcrumbItems.length - 1 && <span class="breadcrumb-sep"> / </span>}
          </span>
        ))}
      </div>
    </nav>
  )}

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <p>© 2026 燃冰 · 叙事平权 · Narrative Equality</p>
      <p class="footer-links">
        <a href="https://github.com/lj22503/diaolong-skill" target="_blank">GitHub</a>
        ·
        <a href={locale === 'en' ? '/en/community' : '/community'}>参与贡献</a>
        ·
        <a href="https://github.com/lj22503/diaolong-skill/blob/main/LICENSE" target="_blank">MIT License</a>
      </p>
    </div>
  </footer>

  <script>
    const btn = document.getElementById('mobileMenuBtn');
    const nav = document.getElementById('mobileNav');
    if (btn && nav) {
      btn.addEventListener('click', () => {
        const open = nav.classList.toggle('open');
        btn.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
      });
      nav.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => nav.classList.remove('open'));
      });
    }
  </script>
</body>
</html>

<style is:global>
  :root {
    --bg: #fafaf8;
    --bg-secondary: #f4f4f2;
    --text: #1a1a1a;
    --text-muted: #666;
    --accent: #c0392b;
    --accent-hover: #a93226;
    --border: #e5e5e3;
    --radius: 6px;
    --font-sans: 'Noto Sans SC', 'Inter', system-ui, sans-serif;
    --font-serif: 'Noto Serif SC', 'Georgia', serif;
    --max-width: 900px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html {
    font-family: var(--font-sans);
    color: var(--text);
    background: var(--bg);
    font-size: 16px;
    line-height: 1.7;
  }

  body { min-height: 100vh; display: flex; flex-direction: column; }

  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--accent); }

  /* Header */
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .header-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px;
    height: 60px;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .header-right {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
  }
  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text);
    padding: 4px;
    border-radius: 4px;
  }
  .mobile-menu-btn:hover { background: var(--bg-secondary); }
  .mobile-nav {
    display: none;
    flex-direction: column;
    border-top: 1px solid var(--border);
    background: var(--bg);
  }
  .mobile-nav.open { display: flex; }
  .mobile-nav a {
    padding: 14px 24px;
    border-bottom: 1px solid var(--border);
    font-size: 0.95rem;
  }
  .mobile-nav a:hover { color: var(--accent); background: var(--bg-secondary); }
  .logo {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    font-weight: 700;
  }
  .logo-zh { font-size: 1.1rem; color: var(--accent); }
  .logo-en { font-size: 0.65rem; color: var(--text-muted); letter-spacing: 0.05em; }
  .logo:hover .logo-zh { color: var(--accent-hover); }

  .main-nav {
    display: flex;
    gap: 24px;
    flex: 1;
  }
  .main-nav a {
    font-size: 0.9rem;
    color: var(--text-muted);
    transition: color 0.15s;
  }
  .main-nav a:hover, .main-nav a.active { color: var(--text); }

  .lang-switch a {
    font-size: 0.8rem;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 3px 10px;
    border-radius: 4px;
    transition: all 0.15s;
  }
  .lang-switch a:hover {
    border-color: var(--text);
    color: var(--text);
  }

  /* Breadcrumb */
  .breadcrumb {
    border-bottom: 1px solid var(--border);
    background: var(--bg-secondary);
    font-size: 0.85rem;
  }
  .breadcrumb-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 12px 24px;
    color: var(--text-muted);
  }
  .breadcrumb-item a {
    color: var(--text-muted);
    transition: color 0.15s;
  }
  .breadcrumb-item a:hover { color: var(--accent); }
  .breadcrumb-sep { margin: 0 6px; color: var(--border); }

  /* Main */
  main { flex: 1; }

  /* Footer */
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 80px;
    padding: 32px 0;
  }
  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .footer-links { margin-top: 8px; display: flex; gap: 8px; justify-content: center; }
  .footer-links a:hover { color: var(--text); }

  /* Shared page styles */
  .page-header {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 64px 24px 48px;
  }
  .page-header h1 {
    font-family: var(--font-serif);
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 12px;
  }
  .page-header p { color: var(--text-muted); font-size: 1.05rem; }

  .page-content {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px 64px;
  }

  /* Cards */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }
  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
    background: white;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    transform: translateY(-2px);
  }
  .card h3 { font-size: 1rem; font-weight: 600; margin-bottom: 8px; }
  .card p { color: var(--text-muted); font-size: 0.88rem; line-height: 1.6; }
  .card .card-tag {
    display: inline-block;
    font-size: 0.72rem;
    color: var(--accent);
    background: rgba(192,57,43,0.08);
    padding: 2px 8px;
    border-radius: 3px;
    margin-bottom: 10px;
  }

  /* Internal links / cross-recommendation block */
  .related-links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
    margin: 32px 0;
  }
  .related-link {
    display: block;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: white;
    transition: all 0.15s;
  }
  .related-link:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .related-link .related-tag {
    font-size: 0.7rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 4px;
  }
  .related-link .related-title {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .related-link .related-desc {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  /* Chapter list */
  .chapter-list { display: flex; flex-direction: column; gap: 12px; }
  .chapter-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: white;
    transition: all 0.15s;
  }
  .chapter-item:hover { border-color: var(--accent); }
  .chapter-num {
    font-family: var(--font-serif);
    font-size: 0.8rem;
    color: var(--text-muted);
    min-width: 60px;
  }
  .chapter-title { flex: 1; font-weight: 500; font-size: 0.95rem; }
  .chapter-versions { display: flex; gap: 8px; }
  .chapter-link {
    font-size: 0.78rem;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 2px 10px;
    border-radius: 3px;
    transition: all 0.15s;
  }
  .chapter-link:hover { background: var(--accent); color: white; }

  /* Section divider */
  .section { margin-bottom: 64px; }
  .section-title {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 600;
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--border);
  }

  /* CTA button */
  .cta {
    display: inline-block;
    background: var(--accent);
    color: white;
    padding: 12px 28px;
    border-radius: var(--radius);
    font-weight: 500;
    font-size: 0.95rem;
    transition: background 0.15s;
  }
  .cta:hover { background: var(--accent-hover); color: white; }
  .cta-outline {
    display: inline-block;
    border: 1px solid var(--border);
    color: var(--text);
    padding: 12px 28px;
    border-radius: var(--radius);
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.15s;
  }
  .cta-outline:hover { border-color: var(--text); color: var(--text); }

  /* Responsive */
  @media (max-width: 640px) {
    .main-nav { display: none; }
    .header-inner { gap: 16px; }
    .mobile-menu-btn { display: flex; }
    .header-right { gap: 8px; }
    .page-header h1 { font-size: 1.8rem; }
    .breadcrumb-inner { padding: 10px 16px; font-size: 0.78rem; }
  }
</style>